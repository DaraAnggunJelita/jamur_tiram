    <td style="padding: 5px; vertical-align: top;">TC-PUB-02</td>
    <td style="padding: 5px; vertical-align: top;">Publik - Akses</td>
    <td style="padding: 5px; vertical-align: top;">Keamanan URL</td>
    <td style="padding: 5px; vertical-align: top;">Mencoba mengakses rute dashboard Admin secara paksa</td>
    <td style="padding: 5px; vertical-align: top;">Browser tanpa sesi login aktif</td>
    <td style="padding: 5px; vertical-align: top;">1. Ketik URL 'localhost:8000/admin/dashboard' secara manual<br>2. Tekan Enter</td>
    <td style="padding: 5px; vertical-align: top;">Rute Protected</td>
    <td style="padding: 5px; vertical-align: top;">Sistem middleware memblokir akses dan me-redirect pengunjung secara paksa kembali ke halaman Login</td>
